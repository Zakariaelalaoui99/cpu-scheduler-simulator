####### Compile

Controller.o: ../cpu-scheduler-simulator/Controller.cpp ../cpu-scheduler-simulator/Controller.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o Controller.o ../cpu-scheduler-simulator/Controller.cpp

main.o: ../cpu-scheduler-simulator/main.cpp ../cpu-scheduler-simulator/CPU.h \
		../cpu-scheduler-simulator/Thread.h \
		../cpu-scheduler-simulator/Process.h \
		../cpu-scheduler-simulator/FCFSScheduler.h \
		../cpu-scheduler-simulator/Scheduler.h \
		../cpu-scheduler-simulator/mainwindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../cpu-scheduler-simulator/main.cpp

CPU.o: ../cpu-scheduler-simulator/CPU.cpp ../cpu-scheduler-simulator/CPU.h \
		../cpu-scheduler-simulator/Thread.h \
		../cpu-scheduler-simulator/Process.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o CPU.o ../cpu-scheduler-simulator/CPU.cpp

Event.o: ../cpu-scheduler-simulator/Event.cpp ../cpu-scheduler-simulator/Event.h \
		../cpu-scheduler-simulator/enums.h \
		../cpu-scheduler-simulator/Process.h \
		../cpu-scheduler-simulator/Thread.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o Event.o ../cpu-scheduler-simulator/Event.cpp

EventQueue.o: ../cpu-scheduler-simulator/EventQueue.cpp ../cpu-scheduler-simulator/EventQueue.h \
		../cpu-scheduler-simulator/Event.h \
		../cpu-scheduler-simulator/enums.h \
		../cpu-scheduler-simulator/Process.h \
		../cpu-scheduler-simulator/Thread.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o EventQueue.o ../cpu-scheduler-simulator/EventQueue.cpp

FCFSScheduler.o: ../cpu-scheduler-simulator/FCFSScheduler.cpp ../cpu-scheduler-simulator/FCFSScheduler.h \
		../cpu-scheduler-simulator/Scheduler.h \
		../cpu-scheduler-simulator/Thread.h \
		../cpu-scheduler-simulator/Process.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o FCFSScheduler.o ../cpu-scheduler-simulator/FCFSScheduler.cpp

RoundRobinScheduler.o: ../cpu-scheduler-simulator/RoundRobinScheduler.cpp ../cpu-scheduler-simulator/RoundRobinScheduler.h \
		../cpu-scheduler-simulator/Scheduler.h \
		../cpu-scheduler-simulator/Thread.h \
		../cpu-scheduler-simulator/Process.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o RoundRobinScheduler.o ../cpu-scheduler-simulator/RoundRobinScheduler.cpp

Process.o: ../cpu-scheduler-simulator/Process.cpp ../cpu-scheduler-simulator/Process.h \
		../cpu-scheduler-simulator/Thread.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o Process.o ../cpu-scheduler-simulator/Process.cpp

Thread.o: ../cpu-scheduler-simulator/Thread.cpp ../cpu-scheduler-simulator/Thread.h \
		../cpu-scheduler-simulator/Process.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o Thread.o ../cpu-scheduler-simulator/Thread.cpp

mainwindow.o: ../cpu-scheduler-simulator/mainwindow.cpp ../cpu-scheduler-simulator/mainwindow.h \
		ui_mainwindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o ../cpu-scheduler-simulator/mainwindow.cpp

moc_mainwindow.o: moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

