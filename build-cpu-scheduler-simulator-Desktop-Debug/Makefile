all: Makefile simulator

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents /usr/lib/x86_64-linux-gnu/qt5/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents ../cpu-scheduler-simulator/CPU.h ../cpu-scheduler-simulator/Controller.h ../cpu-scheduler-simulator/Event.h ../cpu-scheduler-simulator/EventQueue.h ../cpu-scheduler-simulator/FCFSScheduler.h ../cpu-scheduler-simulator/RoundRobinScheduler.h ../cpu-scheduler-simulator/Process.h ../cpu-scheduler-simulator/Thread.h ../cpu-scheduler-simulator/Scheduler.h ../cpu-scheduler-simulator/mainwindow.h $(DISTDIR)/
	$(COPY_FILE) --parents ../cpu-scheduler-simulator/Controller.cpp ../cpu-scheduler-simulator/main.cpp ../cpu-scheduler-simulator/CPU.cpp ../cpu-scheduler-simulator/Event.cpp ../cpu-scheduler-simulator/EventQueue.cpp ../cpu-scheduler-simulator/FCFSScheduler.cpp ../cpu-scheduler-simulator/RoundRobinScheduler.cpp ../cpu-scheduler-simulator/Process.cpp ../cpu-scheduler-simulator/Thread.cpp ../cpu-scheduler-simulator/mainwindow.cpp $(DISTDIR)/
	$(COPY_FILE) --parents ../cpu-scheduler-simulator/mainwindow.ui $(DISTDIR)/


